{
	"name": "adb-plugin-reaction-roles",
	"displayName": "Reaction Roles",
	"version": "2.0.0",
	"description": "Manage reaction roles via slash commands with buttons, select menus, and emoji reactions.",
	"author": "ADB",
	"license": "AGPL-3.0-only",
	"main": "index.js",
	"requiresRestart": true,
	"isolation": false,
	"manifestVersion": 2,
	"process": {
		"model": "persistent",
		"maxExecutionMs": 15000,
		"memoryMb": 256,
		"persistentReason": "Runs un-isolated (system:raw-client) for live guild/member role and hierarchy checks, panel message/component editing, and emoji reaction events and management. These Discord.js objects and operations are not available through the serialized worker RPC surface. Requires owner-approved full host trust."
	},
	"capabilities": {
		"system": ["raw-client"],
		"storage": ["own-collection"],
		"discord": ["SendMessages", "EmbedLinks", "ReadMessageHistory", "ManageRoles", "ManageMessages", "AddReactions", "GuildInfo"],
		"hooks": ["subscribe"]
	},
	"permissions": {
		"system": ["raw-client"],
		"storage": ["own-collection"],
		"discord": ["SendMessages", "EmbedLinks", "ReadMessageHistory", "ManageRoles", "ManageMessages", "AddReactions", "GuildInfo"],
		"hooks": ["subscribe"],
		"network": { "outbound": [] },
		"filesystem": { "read": [], "write": [] },
		"childProcess": false,
		"nativeAddons": false
	},
	"declaredDependencies": [],
	"discordPermissions": ["SendMessages", "EmbedLinks", "ReadMessageHistory", "ManageRoles", "ManageMessages", "AddReactions"],
	"engines": {
		"core": ">=2.0.0",
		"plugins": { "administration": ">=2.0.0" }
	},
	"settings": {
		"commandPermissions": true,
		"schema": []
	},
	"dashboard": {
		"permissions": [
			{ "key": "view", "label": "View", "description": "See reaction role panels." },
			{ "key": "configure", "label": "Configure", "description": "Change reaction roles settings." },
			{ "key": "manage-panels", "label": "Manage panels", "description": "Create, edit, and delete reaction role panels and their role mappings." }
		]
	},
	"webUi": {
		"memberPages": [
			{
				"path": "/me/self-roles",
				"label": "My Self-Roles",
				"icon": "Tags",
				"source": {
					"model": "selection",
					"scope": "member",
					"sort": { "createdAt": -1 },
					"limit": 100
				},
				"view": {
					"type": "table",
					"columns": [
						{ "field": "label", "label": "Role" },
						{ "field": "action", "label": "Change" },
						{ "field": "createdAt", "label": "When" }
					],
					"empty": "You haven't picked any roles in this server yet."
				}
			}
		]
	}
}
